# ===============================================
# EasyWrite 系统环境变量配置示例
# 更推荐在 Web 界面【系统设置】中配置（热重载，无需重启）
# ===============================================

# 大语言模型配置（OpenAI 兼容协议，支持 DeepSeek、通义千问、Kimi、OpenAI 等）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3

# 嵌入模型配置（RAG 语义通道，与生成模型解耦；不配置时自动退化为 BM25+LLM 重排）
# 推荐：硅基流动 SiliconFlow 的 BAAI/bge-m3（注册送额度）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
