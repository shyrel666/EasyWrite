# ===============================================
# EasyWrite 系统环境变量配置示例
# ===============================================

# 大语言模型配置（OpenAI 兼容协议，支持 DeepSeek、通义千问、Kimi、OpenAI 等）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 嵌入模型与向量配置（支持 local 本地分词加权或云端 Embedding）
EMBEDDING_PROVIDER=local
